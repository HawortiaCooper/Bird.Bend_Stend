   "expected": "no latch, LIM S / LIM E green, HOMED red, ENA red, ALM red, CLK green",
   "kind": "auto",
   "auto": {
    "stages": [
     {
      "all": [
       {
        "src": "ind",
        "key": "estop",
        "op": "off"
       },
       {
        "src": "ind",
        "key": "halt",
        "op": "off"
       },
       {
        "src": "ind",
        "key": "paused",
        "op": "off"
       },
       {
        "src": "ind",
        "key": "fault",
        "op": "off"
       },
       {
        "src": "ind",
        "key": "limit_start",
        "op": "off"
       },
       {
        "src": "ind",
        "key": "limit_end",
        "op": "off"
       },
       {
        "src": "ind",
        "key": "homed",
        "op": "off"
       },
       {
        "src": "ind",
        "key": "clk_fallback",
        "op": "off"
       }
      ]
     }
    ]
   }
  },
  {
   "id": "6.9",
   "section": "6",
   "title": "Load cell sign",
   "instruction": "Readouts dock → Raw: pull lightly on the load cell by hand (tension), then push.",
   "expected": "Raw increases on pull (a reversed sign is allowed — write it down)",
   "kind": "measure",
   "fields": [
    {
     "name": "sign",
     "label": "Raw on pull",
     "kind": "choice",
     "choices": [
      "increases",
      "decreases"
     ]
    },
    {
     "name": "raw_pull",
     "label": "Raw while pulling",
     "kind": "number",
     "unit": "counts",
     "decimals": 0,
     "required": false,
     "required_when": {
      "field": "sign",
      "op": "eq",
      "value": "decreases"
     }
    }
   ]
  },
  {
   "id": "7.1",
   "section": "7",
   "title": "E-stop latch",
   "instruction": "Press the red E-stop and keep it pressed for more than 1 s.",
   "expected": "ESTOP red, only ESTOP latched — no K1_WELDED, no other fault",
   "kind": "auto",
   "stop_if_fail": true,
   "hg": "≈ HG-32",
   "auto": {
    "stages": [
     {
      "text": "waiting for ESTOP …",
      "all": [
       {
        "src": "event",
        "key": "ESTOP_SET",
        "op": "seen"
       },
       {
        "src": "ind",
        "key": "estop",
        "op": "on"
       }
      ]
     }
    ],
    "fail_if": [
     {
      "src": "event",
      "key": "FAULT_SET",
      "op": "seen",
      "label": "fault latched"
     }
    ]
   }
  },
  {
   "id": "7.2",
   "section": "7",
   "title": "E-stop clear",
   "instruction": "Release the button (ESTOP stays red), wait ≥ 100 ms → Clear stop… → Clear E-STOP.",
   "expected": "ESTOP green; nothing moves",
   "kind": "auto",
   "action": "clear_stop",
   "auto": {
    "stages": [
     {
      "text": "waiting for Clear E-STOP …",
      "all": [
       {
        "src": "event",
        "key": "ESTOP_CLEARED",
        "op": "seen"
       },
       {
        "src": "ind",
        "key": "estop",
        "op": "off"
       }
      ]
     }
    ],
    "fail_if": [
     {
      "src": "data_flag",
      "key": "MOVING",
      "op": "set",
      "label": "axis moving"
     }
    ]
   }
  },
  {
   "id": "7.3",
   "section": "7",
   "title": "PAUSE button",
   "instruction": "Press and release PAUSE once; then clear with ▶ Resume.",
   "expected": "PAUSED amber (BUTTON), then green after Resume",
   "kind": "auto",
   "auto": {
    "stages": [
     {
      "text": "press PAUSE …",
      "all": [
       {
        "src": "data_status",
        "key": "PAUSED",
        "op": "set"
       }
      ]
