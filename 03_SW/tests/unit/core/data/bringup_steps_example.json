 "steps": [
  {
   "id": "6.3",
   "section": "6",
   "title": "Device line",
   "instruction": "Connection & Config tab: read the Device line.",
   "expected": "FW 0.8.6 (build 20261010-2135), dict hash 0xF8BCDCB8 ✓",
   "kind": "auto",
   "stop_if_fail": true,
   "hg": "≈ HG gate S-00 identity check",
   "action": "show:connection",
   "auto": {
    "stages": [
     {
      "text": "waiting for the board identity (GET_INFO) …",
      "all": [
       {
        "src": "info",
        "key": "fw_version",
        "op": "eq",
        "value": "0.8.6",
        "label": "FW"
       },
       {
        "src": "info",
        "key": "build",
        "op": "eq",
        "value": "20261010-2135",
        "label": "build"
       },
       {
        "src": "info",
        "key": "param_dict_hash",
        "op": "eq",
        "value": {
         "$const": "PARAM_DICT_HASH"
        },
        "label": "dict hash"
       },
       {
        "src": "info",
        "key": "uid",
        "op": "present",
        "label": "UID"
       }
      ]
     }
    ]
   }
  },
  {
   "id": "6.5",
   "section": "6",
   "title": "Link at 80 Hz",
   "instruction": "Link line: about 80 Hz samples, no losses growing; LINK chip green CONNECTED.",
   "expected": "LINK CONNECTED, 76…84 SPS",
   "kind": "auto",
   "auto": {
    "stages": [
     {
      "text": "waiting for the stream …",
      "all": [
       {
        "src": "link",
        "key": "state",
        "op": "eq",
        "value": "CONNECTED",
        "label": "link"
       },
       {
        "src": "stream",
        "key": "rate_sps",
        "op": "between",
        "value": [
         76,
         84
        ],
        "label": "rate [SPS]"
       }
      ]
     }
    ],
    "timeout_s": 30
   }
  },
  {
   "id": "6.7",
   "section": "6",
   "title": "Board configuration",
   "instruction": "Board configuration table (tick show advanced): check the listed values.",
   "expected": "drv.pwr_sense_enable 0, drv.k1_check_enable 0, motion.steps_per_mm 800, afe.rate_sps 80 SPS",
   "kind": "auto",
   "stop_if_fail": true,
   "hg": "≈ HG-32 / C-26",
   "auto": {
    "stages": [
     {
      "all": [
       {
        "src": "param",
        "key": "drv.pwr_sense_enable",
        "op": "eq",
        "value": 0
       },
       {
        "src": "param",
        "key": "drv.k1_check_enable",
        "op": "eq",
        "value": 0
       },
       {
        "src": "param",
        "key": "motion.steps_per_mm",
        "op": "eq",
        "value": 800
       }
      ]
     }
    ]
   }
  },
  {
