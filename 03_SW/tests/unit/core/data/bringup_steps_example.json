   "section": "10",
   "title": "I_LED readings decided",
   "instruction": "Readings of 10.1.3 / 10.1.4 below 0.60 V: repeat with the mA range in series (or a 10 Ω shunt).",
   "expected": "≥ 6 mA on ENA and DIR",
   "kind": "measure",
   "fields": [
    {
     "name": "readings",
     "label": "Readings",
     "kind": "choice",
     "choices": [
