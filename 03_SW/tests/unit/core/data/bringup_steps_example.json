       "step": "10.1.3",
       "field": "u_ena",
       "op": "lt",
       "value": 0.6
      }
     ]
    },
    {
     "name": "i_dir_ma",
     "label": "I_LED DIR (mA range)",
     "kind": "number",
     "unit": "mA",
     "min": 6.0,
     "decimals": 2,
